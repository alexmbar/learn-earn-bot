# Configuracion de learn-earn-bot
# Copia este archivo como config.env y ajusta los valores
# Uso: source config.env && python scheduler.py daily

# Hora de apertura diaria (formato HH:MM)
LEB_DAILY_TIME=09:00

# Categoria por defecto: learn_earn | microtask | (vacio = todas)
LEB_CATEGORY=

# Delay entre URLs en segundos
LEB_DELAY=1.5

# Meta de ingresos en USD
LEB_GOAL=5.0

# Intervalo en horas para el modo interval
LEB_HOURS=24
